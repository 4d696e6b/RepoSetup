{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposetup.dev/schemas/reposetup.schema.json",
  "title": "RepoSetupConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "runtime",
    "packageManager",
    "framework",
    "integrations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/\\x00]+$",
          "not": {
            "enum": [".", ".."]
          },
          "description": "Single directory-safe project name. Path separators and '..' are rejected."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\\\)(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "description": "Optional project-relative path. Absolute paths and '..' segments are rejected."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "enum": [
            "node",
            "python"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packageManager": {
      "enum": [
        "npm",
        "pnpm",
        "bun",
        "uv",
        "pip"
      ]
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object"
          }
        }
      }
    }
  }
}
