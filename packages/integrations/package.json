{
  "name": "@reposetup/integrations",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "description": "Built-in RepoSetup integration definitions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external @reposetup/core --external @reposetup/registry --external zod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@reposetup/core": "workspace:*",
    "@reposetup/registry": "workspace:*",
    "zod": "^4.6.5"
  }
}
