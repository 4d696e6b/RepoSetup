{
  "name": "@reposetup/core",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4d696e6b/RepoSetup.git"
  },
  "bugs": {
    "url": "https://github.com/4d696e6b/RepoSetup/issues"
  },
  "homepage": "https://github.com/4d696e6b/RepoSetup#readme",
  "description": "RepoSetup config, resolution, planning, and execution library.",
  "private": true,
  "type": "module",
