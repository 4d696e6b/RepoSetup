{
  "name": "rsetup",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4d696e6b/RepoSetup.git"
  },
  "bugs": {
    "url": "https://github.com/4d696e6b/RepoSetup/issues"
  },
  "homepage": "https://github.com/4d696e6b/RepoSetup#readme",
  "description": "Compose, validate, and configure development stacks from the terminal.",
  "keywords": [
    "cli",
    "developer-tools",
    "scaffolding",
    "typescript",
    "nodejs",
    "python",
    "pnpm",
    "installer"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rsetup": "./dist/bin.js",
    "reposetup": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@reposetup/core": "workspace:*",
    "@reposetup/integrations": "workspace:*",
    "@reposetup/registry": "workspace:*",
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0"
  }
}
