{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "public": false,
  "installCommand": "npx --yes pnpm@12.5.1 install --frozen-lockfile --prod=false",
  "buildCommand": "node --experimental-strip-types apps/website/scripts/build-vercel.ts",
  "outputDirectory": ".vercel/output/static",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"codex/0.2.3-website\" ]; then exit 1; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "codex/0.2.3-website": true
    }
  }
}
